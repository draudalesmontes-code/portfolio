# Template — committed to git. NO real secrets here.
# Copy to .env and fill in real values (.env is git-ignored).

POSTGRES_USER=folioAdmin
POSTGRES_PASSWORD=
POSTGRES_DB=portfolio

# Spring reads this; must equal POSTGRES_PASSWORD
PASSWORD_JAVA_DB=

# Authentication
# Generate a Base64-encoded secret containing at least 32 random bytes.
JWT_SECRET=
# Use false only for local HTTP. Production HTTPS deployments must use true.
AUTH_COOKIE_SECURE=false

# Transactional email
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev
BASE_URL=http://localhost
CORE_API_PROXY_BASE=http://localhost/api

# Groq free API key — get one at console.groq.com
GROQ_API_KEY=
