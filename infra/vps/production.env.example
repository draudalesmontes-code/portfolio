# Public hostname. Do not include https:// or a trailing slash.
# Custom domain: portfolio.example.com
# Free temporary hostname: portfolio-203-0-113-10.sslip.io
DOMAIN=portfolio.example.com
ACME_EMAIL=you@example.com
BASE_URL=https://portfolio.example.com

POSTGRES_USER=folioAdmin
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=portfolio

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes-base64-encoded

RESEND_API_KEY=replace-with-your-resend-key
RESEND_FROM="Portfolio <portfolio@your-verified-domain.example>"

GROQ_API_KEY=replace-with-your-groq-key
